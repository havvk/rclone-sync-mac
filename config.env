# ==============================================================================
# Cloud Sync - 配置文件
# 支持所有 rclone 兼容的云存储服务
# ==============================================================================

# ---- 基础路径 ----
LOCAL_PATH="$HOME/OneDrive"
REMOTES="onedrive: gdrive:"                  # 云存储列表（空格分隔），示例: "onedrive: gdrive: dropbox:"

# ---- 同步设置 ----
SYNC_INTERVAL=1800
CONFLICT_RESOLVE="newer"
CONFLICT_SILENT=true
MAX_DELETE_PCT=50

# ---- 网络 ----
SOCKS5_PROXY="socks5://127.0.0.1:20888"

# ---- 日志 ----
LOG_RETAIN_DAYS=7

# ---- 数据目录（一般无需修改） ----
DATA_DIR="$HOME/.local/share/rclone-sync-mac"